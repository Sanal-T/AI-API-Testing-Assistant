# ==============================================================================
# AI API Testing Assistant — Environment Configuration
# ==============================================================================

# --- AI Provider Configuration ---
# Required only if AI Failure Analysis is enabled.
# The tool operates fully deterministically without an API key if this is omitted.
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Server & Logging Configuration ---
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
