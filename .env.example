# ==============================================================================
# AI API Testing Assistant — Environment Configuration
# ==============================================================================

# --- AI Provider Configuration (Optional) ---
# Supported providers: 'openai', 'gemini', 'anthropic', 'local' / 'ollama'
# The tool operates fully deterministically without an AI key if these are omitted.
AI_PROVIDER=auto

# 1. OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# 2. Google Gemini Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# 3. Anthropic Claude Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 4. Local / On-Premise LLM Configuration (Ollama / vLLM / LocalAI)
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3

# --- Server & Logging Configuration ---
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
